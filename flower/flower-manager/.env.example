# 花间集服务端配置（复制为 .env 或直接设置环境变量）

PORT=8787
HOST=0.0.0.0

# ===== AI 模型 =====
# 默认使用 Pollinations 的匿名 OpenAI 兼容接口（无需 Key，支持 tools）
# 免费额度约为每 45 秒 1 次请求；超出时自动使用本地经营规则回答。
# 生产环境建议配置自己的模型服务：
# LLM_ENDPOINT=https://api.deepseek.com/chat/completions
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#
# 也兼容 OpenAI：
# LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 强制只使用本地经营规则（离线演示）
# LLM_DISABLE=1

# 单轮模型规划 + 本地工具执行（Pollinations 默认开启）
# LLM_ONE_SHOT=1

# 模型请求超时时间（毫秒）
# LLM_TIMEOUT_MS=60000
