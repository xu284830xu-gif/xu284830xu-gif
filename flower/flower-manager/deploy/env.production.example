# 花间集 · 生产环境变量示例
# 复制到 /etc/huajian.env（权限 600），改完 systemctl restart huajian

# ---------- 服务 ----------
PORT=8787
# 用 Nginx 反代时保持 127.0.0.1；要直接对外则改 0.0.0.0 并在安全组放行 8787
HOST=127.0.0.1

# ---------- AI 模型（可选） ----------
# 不配置时走 Pollinations 匿名接口，免费额度约 45 秒 1 次，超出自动回退本地规则
# LLM_ENDPOINT=https://api.deepseek.com/chat/completions
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_TIMEOUT_MS=60000
# LLM_DISABLE=1

# ---------- 顾客端展示 ----------
# SHOP_HOURS=09:00 - 21:00
# SHOP_PHONE=0571-88888888
# SHOP_DELIVERY_NOTE=同城配送 · 当日鲜花 · 满 ¥99 免配送费
# SHOP_PICKUP_NOTE=到店自提 · 下单后请保持电话畅通
